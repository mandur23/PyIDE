{
  "name": "pyide",
  "productName": "PyIDE",
  "version": "0.2.11",
  "description": "PyCharm-style Python IDE",
  "updateFeed": "https://github.com/mandur23/Portfolio-Nano-/releases/download/pyide/",
  "repository": {
    "type": "git",
    "url": "https://github.com/mandur23/PyIDE.git"
  },
  "bugs": {
    "url": "https://github.com/mandur23/PyIDE/issues"
  },
  "author": {
    "name": "PyIDE",
    "email": "ms01048913077@gmail.com"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "clean:tests": "node verify/clean.mjs",
    "vendor": "python -m pip install --upgrade --target vendor debugpy==1.8.22 ruff==0.17.1",
    "dist": "electron-builder --win nsis msi --x64",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "electron": "^38.8.6",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.1.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/addon-unicode11": "^0.8.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "dictionary-en": "^4.0.0",
    "electron-updater": "^6.8.9",
    "iconv-lite": "^0.6.3",
    "marked": "^12.0.2",
    "monaco-editor": "0.57.0",
    "nspell": "^2.1.5",
    "pyright": "^1.1.406"
  },
  "build": {
    "appId": "dev.pyide.ide",
    "productName": "PyIDE",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "electronDist": "node_modules/electron/dist",
    "electronLanguages": [
      "en-US",
      "ko"
    ],
    "npmRebuild": false,
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "CHANGELOG.md",
      "main/**/*",
      "renderer/**/*",
      "plugins-catalog/**/*",
      "vendor/**/*",
      "!**/__pycache__",
      "!**/*.{pdb,map}",
      "!node_modules/monaco-editor/{dev,esm,min-maps}",
      "!node_modules/monaco-editor/node_modules/**",
      "!node_modules/monaco-editor/min/vs/language/*/*.worker.js",
      "!node_modules/monaco-editor/min/vs/nls/lang/{!(ko).js,*.d.ts}",
      "!node_modules/dompurify"
    ],
    "asarUnpack": [
      "main/**/*.py",
      "renderer/features/**/*.py",
      "vendor/**/*",
      "node_modules/pyright/**/*",
      "node_modules/@lydell/**/*"
    ],
    "msiProjectCreated": "build/msi-project.js",
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/mandur23/Portfolio-Nano-/releases/download/pyide/"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "msi",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createStartMenuShortcut": true,
      "createDesktopShortcut": false,
      "shortcutName": "PyIDE",
      "uninstallDisplayName": "PyIDE",
      "artifactName": "PyIDE-Setup-${version}.exe",
      "include": "build/installer.nsh"
    },
    "msi": {
      "perMachine": false,
      "upgradeCode": "C8A5FFE8-0263-4874-B6AC-E39E095BE819",
      "createStartMenuShortcut": true,
      "createDesktopShortcut": false,
      "shortcutName": "PyIDE",
      "artifactName": "PyIDE-${version}.msi"
    }
  }
}
